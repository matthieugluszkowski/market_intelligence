# =============================================================
# market_intelligence - variables d'environnement
# Copier en .env et renseigner. .env n'est JAMAIS committe.
# =============================================================

# --- Supabase / Postgres ---------------------------------------------------
# Pooler transaction (IPv4, pgbouncer) : usage applicatif courant.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pooler session : DDL, migrations, transactions longues.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"
SUPABASE_PROJECT_REF="<PROJECT_REF>"

# --- Stockage froid (Parquet) ---------------------------------------------
COLD_STORAGE_PATH="./data/parquet"

# --- Ingestion -------------------------------------------------------------
# Debit menage pour ne pas se faire rate-limiter (doc 02 SS4).
STOOQ_RATE_LIMIT_SEC=1.0
YFINANCE_RATE_LIMIT_SEC=2.0
HTTP_TIMEOUT_SEC=30
HTTP_MAX_RETRIES=3
AMF_API_BASE="https://api.info-financiere.fr/api/v1"
ECB_API_BASE="https://data-api.ecb.europa.eu/service/data"
ESEF_API_BASE="https://filings.xbrl.org"

# --- Moteur analytique -----------------------------------------------------
METHOD_VERSION=1
DILUTION_THRESHOLD_12M=0.50
JUMP_ALERT_THRESHOLD=0.25

# --- Exploitation ----------------------------------------------------------
LOG_LEVEL=INFO
TZ="Europe/Paris"
